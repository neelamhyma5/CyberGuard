rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.keys().hasOnly(['id', 'displayName', 'email', 'photoURL', 'createdAt'])
        && data.id is string && data.id.size() <= 128 && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 160
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidAssessmentRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'overallScore', 'level', 'completedAt'])
        && data.keys().hasOnly(['id', 'userId', 'overallScore', 'level', 'answers', 'completedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.overallScore is number && data.overallScore >= 0 && data.overallScore <= 100
        && data.level is string && data.level.size() <= 64
        && data.completedAt is string && data.completedAt.size() <= 64;
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      // User assessment history subcollection
      match /assessments/{assessmentId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(assessmentId) && isValidAssessmentRecord(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(assessmentId);
      }
    }
  }
}
